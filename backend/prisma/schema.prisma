generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("SALES_REP") // ADMIN, MANAGER, SALES_REP
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdCustomers  Customer[]
  assignedLeads     Lead[]
  ownedDeals        Deal[]
  assignedTasks     Task[]
  notes             Note[]
  activityLogs      ActivityLog[]

  // Phase 2 Banking Relations
  verifiedDocuments KycDocument[]
  approvedDeals     Deal[]        @relation("DealApprovals")
  assignedTickets   Ticket[]      @relation("AssignedTickets")
  createdTickets    Ticket[]      @relation("CreatedTickets")

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String
  address     String?
  city        String?
  type        String   @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS
  kycStatus   String   @default("PENDING")    // PENDING, VERIFIED, REJECTED
  cibilScore  Int?     @default(750)
  monthlyIncome Float?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads        Lead[]
  deals        Deal[]
  kycDocuments KycDocument[]
  tickets      Ticket[]

  @@map("customers")
}

model Lead {
  id              String    @id @default(uuid())
  name            String
  phone           String
  email           String
  source          String    @default("WEBSITE") // WEBSITE, BRANCH, REFERRAL, CALL
  productInterest String
  status          String    @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST, CONVERTED
  assignedToId    String?
  assignedTo      User?     @relation(fields: [assignedToId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deals Deal[]

  @@map("leads")
}

model Deal {
  id         String    @id @default(uuid())
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  title      String
  amount     Float
  stage      String    @default("NEW") // NEW, CONTACTED, DOCUMENTS, VERIFICATION, APPROVED, WON, LOST
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])

  // Phase 2: Banking Loan & Product Pipeline
  loanType          String?   @default("PERSONAL_LOAN") // HOME_LOAN, PERSONAL_LOAN, AUTO_LOAN, BUSINESS_LOAN, GOLD_LOAN
  tenureMonths      Int?      @default(36)
  interestRate      Float?    @default(10.5)
  monthlyIncome     Float?
  eligibilityStatus String?   @default("PENDING") // ELIGIBLE, INELIGIBLE, CONDITIONAL, PENDING
  eligibilityNotes  String?

  // Phase 2: Maker-Checker Approval Workflow
  approvalStatus    String    @default("DRAFT") // DRAFT, SUBMITTED_FOR_APPROVAL, APPROVED, REJECTED
  submittedAt       DateTime?
  approvedById      String?
  approvedBy        User?     @relation("DealApprovals", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  approvalNotes     String?
  rejectionReason   String?

  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  updatedAt  DateTime  @updatedAt

  @@map("deals")
}

model KycDocument {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType    String    // PAN, AADHAAR, PASSPORT, SALARY_SLIP, ITR
  documentNumber  String
  fileUrl         String?
  status          String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedById    String?
  verifiedBy      User?     @relation(fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("kyc_documents")
}

model Ticket {
  id              String    @id @default(uuid())
  ticketNumber    String    @unique
  title           String
  description     String
  category        String    @default("GENERAL") // TRANSACTION, CARD, LOAN, KYC, GENERAL
  priority        String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status          String    @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdById     String?
  createdBy       User?     @relation("CreatedTickets", fields: [createdById], references: [id])
  dueDate         DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("tickets")
}

model Task {
  id           String   @id @default(uuid())
  title        String
  type         String   @default("FOLLOW_UP") // CALL, MEETING, EMAIL, FOLLOW_UP
  dueDate      DateTime
  status       String   @default("PENDING") // PENDING, COMPLETED
  relatedType  String   // LEAD, CUSTOMER, DEAL
  relatedId    String
  assignedToId String
  assignedTo   User     @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tasks")
}

model Note {
  id          String   @id @default(uuid())
  content     String
  relatedType String   // LEAD, CUSTOMER, DEAL
  relatedId   String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("notes")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // CREATE, UPDATE, DELETE, STAGE_CHANGE, CONVERT, LOGIN, KYC_VERIFY, DEAL_APPROVE, ROLE_CHANGE
  entityType String   // LEAD, CUSTOMER, DEAL, TASK, USER, KYC_DOCUMENT, TICKET
  entityId   String
  details    String?
  createdAt  DateTime @default(now())

  @@map("activity_logs")
}
